### 1. 테스트 유저 생성 (회원가입)
POST http://localhost:8080/auth/signup
Content-Type: application/json

{
  "email": "cascade_test@example.com",
  "password": "Password123!",
  "userRole": "USER",
  "nickname": "캐스케이드"
}

> {%
    client.global.set("token", response.body.bearerToken);
    client.log("토큰 발급 완료: " + response.body.bearerToken);
%}


### 2. 로그인
POST http://localhost:8080/auth/signin
Content-Type: application/json

{
  "email": "cascade_test@example.com",
  "password": "Password123!"
}

> {%
    client.global.set("token", response.body.bearerToken);
%}


### 3. 새로운 할 일(Todo) 생성
# 새 할 일을 만들 때, 작성자가 자동으로 담당자(Manager)로 영속성 전이(Cascade) 되는지 테스트합니다.
POST http://localhost:8080/todos
Content-Type: application/json
Authorization: {{token}}

{
  "title": "Cascade 테스트 할 일",
  "contents": "저장할 때 담당자도 같이 저장될까?"
}

> {%
    // 새로 생성된 Todo의 ID를 저장합니다.
    client.global.set("todoId", response.body.id);
    client.log("생성된 Todo ID: " + response.body.id);
%}


### 4. 생성된 할 일의 담당자(Manager) 목록 조회
# 방금 생성한 할 일의 담당자 목록을 불러옵니다.
# 결과에 'cascade_test@example.com' 유저가 담당자로 잘 들어가 있으면 성공입니다!
GET http://localhost:8080/todos/{{todoId}}/managers
Authorization: {{token}}

> {%
    client.log("\n======================================");
    client.log("🔍 담당자 등록 결과 확인");
    
    if (response.body.length > 0) {
        client.log("✅ 성공! 총 " + response.body.length + "명의 담당자가 자동 등록되었습니다.");
        response.body.forEach(function(manager, index) {
            client.log("  담당자 " + (index+1) + " 이메일: " + manager.user.email + " (닉네임: " + manager.user.nickname + ")");
        });
    } else {
        client.log("❌ 실패... 담당자가 아무도 등록되지 않았습니다 (Cascade 미작동)");
    }
    client.log("======================================\n");
%}
